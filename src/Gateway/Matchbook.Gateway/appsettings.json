{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://localhost:8080/realms/matchbook",
    "Audience": "matchbook",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5301" ]
  },
  "ReverseProxy": {
    "Routes": {
      "suppliers": {
        "ClusterId": "suppliers",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/suppliers/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "cost-centres": {
        "ClusterId": "budgets",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/cost-centres/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "budgets": {
        "ClusterId": "budgets",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/budgets/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "requisitions": {
        "ClusterId": "requisitions",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/requisitions/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "approvals": {
        "ClusterId": "requisitions",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/approvals/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "purchase-orders": {
        "ClusterId": "purchasing",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/purchase-orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "invoices": {
        "ClusterId": "payables",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/invoices/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payment-runs": {
        "ClusterId": "payables",
        "RateLimiterPolicy": "per-caller",
        "Match": { "Path": "/api/payment-runs/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "openapi-suppliers": {
        "ClusterId": "suppliers",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/openapi/suppliers.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-budgets": {
        "ClusterId": "budgets",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/openapi/budgets.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-requisitions": {
        "ClusterId": "requisitions",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/openapi/requisitions.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-purchasing": {
        "ClusterId": "purchasing",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/openapi/purchasing.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-payables": {
        "ClusterId": "payables",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/openapi/payables.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      }
    },
    "Clusters": {
      "suppliers": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5311" } }
      },
      "budgets": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5312" } }
      },
      "requisitions": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5313" } }
      },
      "purchasing": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5314" } }
      },
      "payables": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5315" } }
      }
    }
  }
}
