{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      // EF logs every failed command and save as an error, twice, including the unique violations and lost races
      // answered with a 409 on purpose. A failure nobody expected still reaches the log once, as an unhandled
      // exception carrying the Postgres error and the constraint's name.
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
      "Microsoft.EntityFrameworkCore.Update": "Critical",
      "MassTransit": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://localhost:8080/realms/matchbook",
    "Audience": "matchbook",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5440;Database=suppliers;Username=suppliers;Password=suppliers",
    "RabbitMq": "amqp://matchbook:matchbook@localhost:5672/"
  },
  "Encryption": {
    "ActiveKey": "dev1",
    "Keys": {
      "dev1": "rwtgJwHKYgYxWLnCrgEOmiekii+Q3QO+3daj91P58DY="
    }
  }
