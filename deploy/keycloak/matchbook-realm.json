{
  "realm": "matchbook",
  "enabled": true,
  "displayName": "Matchbook",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "requester",
        "description": "Raises requisitions"
      },
      {
        "name": "approver",
        "description": "Approves requisitions for the cost centres they manage"
      },
      {
        "name": "finance-approver",
        "description": "Second approval above 10,000"
      },
      {
        "name": "cfo",
        "description": "Third approval above 100,000"
      },
      {
        "name": "buyer",
        "description": "Turns approved requisitions into purchase orders"
      },
      {
        "name": "receiver",
        "description": "Records goods received"
      },
      {
        "name": "ap-clerk",
        "description": "Captures supplier invoices"
      },
      {
        "name": "ap-approver",
        "description": "Accepts price variances and clears suspected duplicates"
      },
      {
        "name": "treasurer",
        "description": "Drafts and releases payment runs"
      },
      {
        "name": "supplier-admin",
        "description": "Creates suppliers and proposes bank accounts"
      },
      {
        "name": "supplier-approver",
        "description": "Activates suppliers and approves bank accounts"
      },
      {
        "name": "budget-admin",
        "description": "Sets up cost centres and budgets"
      },
      {
        "name": "auditor",
        "description": "Reads everything, changes nothing"
      }
    ]
  },
  "clients": [
    {
      "clientId": "matchbook-console",
      "name": "Matchbook console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5301/*",
        "http://localhost:5302/*",
        "http://localhost:5303/*",
        "http://localhost:5304/*",
        "http://localhost:5305/*"
      ],
      "webOrigins": [
        "http://localhost:5301",
        "http://localhost:5302",
        "http://localhost:5303",
        "http://localhost:5304",
        "http://localhost:5305"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5301/*##http://localhost:5302/*##http://localhost:5303/*##http://localhost:5304/*##http://localhost:5305/*"
      },
      "protocolMappers": [
        {
          "name": "matchbook-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "matchbook",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matchbook-cli",
      "name": "Matchbook command line (development only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "matchbook-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "matchbook",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
