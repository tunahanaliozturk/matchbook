<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The whole compose stack from outside: people sign in to Keycloak and work through the gateway, containers
    are restarted and killed underneath them, and afterwards the five databases have to agree. Needs the stack
    running first, as the README's quick start brings it up.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Matchbook.Stack\Matchbook.Stack.csproj" />
    <ProjectReference Include="..\Matchbook.Testing\Matchbook.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
